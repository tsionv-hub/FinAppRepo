{
  "name": "finance-planner",
  "private": true,
  "version": "1.17.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "npm run build && (vite preview --port 4173 --strictPort & sleep 2; tsx tests/e2e/smoke.ts http://localhost:4173/ .; s=$?; kill %1; exit $s)"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
